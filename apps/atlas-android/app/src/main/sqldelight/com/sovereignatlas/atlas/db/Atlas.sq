-- Schema version 2. See migrations/1.sqm for the 1 -> 2 change and ADR-007 for
-- why versioning exists at all. The column defaults to PRIVATE here for the same
-- reason the migration does: Phase 10 §10.6 requires explicit opt-in, so a
-- fresh install must not start with waypoints considered shareable.
CREATE TABLE IF NOT EXISTS Waypoint (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    timestamp INTEGER NOT NULL,
    notes TEXT,
    sharingPolicy TEXT NOT NULL DEFAULT 'PRIVATE'
);

selectAllWaypoints:
SELECT * FROM Waypoint ORDER BY timestamp DESC;

insertWaypoint:
INSERT OR REPLACE INTO Waypoint (id, name, latitude, longitude, timestamp, notes, sharingPolicy)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteWaypoint:
DELETE FROM Waypoint WHERE id = ?;

CREATE TABLE IF NOT EXISTS Track (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    distance_meters REAL NOT NULL,
    geometry TEXT NOT NULL
);

selectAllTracks:
SELECT * FROM Track ORDER BY timestamp DESC;

insertTrack:
INSERT OR REPLACE INTO Track (id, name, timestamp, distance_meters, geometry)
VALUES (?, ?, ?, ?, ?);

deleteTrack:
DELETE FROM Track WHERE id = ?;

CREATE TABLE IF NOT EXISTS TrackPointBuffer (
    track_id TEXT NOT NULL,
    sequence INTEGER NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    altitude REAL,
    timestamp INTEGER NOT NULL,
    PRIMARY KEY (track_id, sequence)
);

insertTrackPoint:
INSERT OR REPLACE INTO TrackPointBuffer (track_id, sequence, latitude, longitude, altitude, timestamp)
VALUES (?, ?, ?, ?, ?, ?);

getTrackPoints:
SELECT * FROM TrackPointBuffer WHERE track_id = ? ORDER BY sequence ASC;

clearTrackPoints:
DELETE FROM TrackPointBuffer WHERE track_id = ?;

updateTrackPointAltitude:
UPDATE TrackPointBuffer SET altitude = ? WHERE track_id = ? AND sequence = ?;

getMaxSequence:
SELECT MAX(sequence) AS maxSequence FROM TrackPointBuffer WHERE track_id = ?;
