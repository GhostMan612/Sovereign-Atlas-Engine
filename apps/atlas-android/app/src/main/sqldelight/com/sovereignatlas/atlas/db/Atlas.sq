CREATE TABLE IF NOT EXISTS Waypoint (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    timestamp INTEGER NOT NULL,
    notes TEXT
);

selectAllWaypoints:
SELECT * FROM Waypoint ORDER BY timestamp DESC;

insertWaypoint:
INSERT OR REPLACE INTO Waypoint (id, name, latitude, longitude, timestamp, notes)
VALUES (?, ?, ?, ?, ?, ?);

deleteWaypoint:
DELETE FROM Waypoint WHERE id = ?;

CREATE TABLE IF NOT EXISTS Track (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    distance_meters REAL NOT NULL,
    geometry TEXT NOT NULL
);

selectAllTracks:
SELECT * FROM Track ORDER BY timestamp DESC;

insertTrack:
INSERT OR REPLACE INTO Track (id, name, timestamp, distance_meters, geometry)
VALUES (?, ?, ?, ?, ?);

deleteTrack:
DELETE FROM Track WHERE id = ?;

CREATE TABLE IF NOT EXISTS TrackPointBuffer (
    track_id TEXT NOT NULL,
    sequence INTEGER NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    altitude REAL,
    timestamp INTEGER NOT NULL,
    PRIMARY KEY (track_id, sequence)
);

insertTrackPoint:
INSERT OR REPLACE INTO TrackPointBuffer (track_id, sequence, latitude, longitude, altitude, timestamp)
VALUES (?, ?, ?, ?, ?, ?);

getTrackPoints:
SELECT * FROM TrackPointBuffer WHERE track_id = ? ORDER BY sequence ASC;

clearTrackPoints:
DELETE FROM TrackPointBuffer WHERE track_id = ?;
