<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Atlas" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#10151C</item>
        <item name="android:statusBarColor">#10151C</item>
        <item name="android:navigationBarColor">#10151C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.SplashScreen.Atlas" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#10151C</item>
        <item name="windowSplashScreenIconBackgroundColor">#18222E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_atlas</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Atlas</item>
    </style>
</resources>
