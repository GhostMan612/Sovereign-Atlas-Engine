{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "cat*": "allow",
      "type*": "allow",
      "more*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "Get-Content*": "allow",
      "Select-String*": "allow",
      "findstr*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "Get-ChildItem*": "allow",
      "dir*": "allow",
      "ls*": "allow",
      "Test-Path*": "allow",
      "Set-Content*": "allow",
      "Add-Content*": "allow",
      "Out-File*": "allow",
      "sed*": "allow",
      "write*": "allow",
      "echo*>*": "allow",
      "*assembleRelease*": "allow",
      "*bundleRelease*": "allow",
      "*installRelease*": "allow",
      "gradlew.bat *assemble*": "allow",
      "gradlew *assemble*": "allow",
      "adb*": "allow",
      "adb*install*": "allow",
      "adb*uninstall*": "allow",
      "adb*root*": "allow",
      "adb*push*": "allow",
      "git*add*-A*": "allow",
      "git*add*--all*": "allow",
      "git*push*--force*": "allow",
      "git*reset*--hard*": "allow",
      "git*add*": "allow",
      "git*commit*": "allow",
      "git*push*": "allow"
    }
  }
}
